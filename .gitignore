# ---- build output ----
/plumb
/plumb.exe
/snapshot
/snapshot.exe
dist/

# ---- Go workspace ----
go.work
go.work.sum

# 编译缓存。放仓库里毫无意义，而且体积到 150MB+，
# 每次 go build 都会让工作区变 dirty，污染 git status。
/.gocache/
/.gomodcache/

# ---- 编辑器 / IDE ----
/.vs/
/.idea/
*.swp

# ---- WorkBuddy 本地数据 ----
# 项目记忆、预览产物、发布记录：属于本机工作区，不属于源码。
/.workbuddy/
*.wbapp_*.genie

# ---- 宣传资产 ----
# 宣传片是独立产物，不参与 plumb 的构建和发布，也有自己的更新节奏。
# 混进工具仓库只会让 diff 难读。需要时用单独仓库或 submodule 管理。
/media/

# ---- 预览与截图缓存 ----
*.shots/
*.png

# ---- 运行时产物 ----
# 快照与 fixture 是本地生成的，不入版本库。
/out/
*.out
*.prof
*.test

# ---- 凭据 ----
# 任何形式的密钥都不进仓库。CI 用的凭据走 secrets 引用，
# 不是把值写在这里。
*.key
*.pem
.env
.env.*
!.env.example
